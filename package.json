		"@tailwindcss/vite": "^4.3.3",
		"beautiful-mermaid": "1.1.3",
		"husky": "^9.1.7",
		"image-size": "^2.0.4",
		"lint-staged": "^16.2.6",
		"mdsvex": "^0.12.8",
		"oxlint": "^1.26.0",
