{
	"name": "collinmurch",
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*",
		"#components/*": "./src/components/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "oxlint --max-warnings=0",
		"lint:fix": "oxlint --fix --max-warnings=0",
		"test": "bun test",
		"format": "prettier --check .",
		"format:write": "prettier --write .",
		"budget": "bun scripts/check-bundle-size.js",
		"prepare": "husky",
		"lint-staged": "lint-staged"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"beautiful-mermaid": "1.1.3",
		"husky": "^9.1.7",
		"image-size": "^2.0.4",
		"katex": "^0.19.0",
		"lint-staged": "^17.6.0",
		"mdsvex": "^0.12.8",
		"oxlint": "^1.88.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"roughjs": "^4.6.6",
		"shiki": "^4.5.0",
		"svelte": "^5.57.2",
		"tailwindcss": "^4.3.3",
		"vite": "^8.3.4",
		"yaml": "^2.9.1"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,jsx,tsx}": [
			"oxlint --fix --max-warnings=0"
		],
		"*.{js,ts,cjs,mjs,jsx,tsx,svelte,md,json,css,html}": [
			"prettier --write --ignore-unknown"
		]
	}
}
